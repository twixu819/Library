<Window x:Class="Library.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        mc:Ignorable="d"
        Title="+ Додати книгу" Height="380" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Додати книгу" FontSize="18" FontWeight="Bold"  Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Назва книги:" Margin="0,4,0,2" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="TitleBox" Padding="6,4" FontSize="13" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Автор:" Margin="0,8,0,2" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="AuthorBox" Padding="6,4" FontSize="13" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Дисципліна / Код:" Margin="0,8,0,2" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="DisciplineBox" Padding="6,4" FontSize="13" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Кількість примірників:" Margin="0,8,0,2" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="CopiesBox" Text="" Padding="6,4" FontSize="13" BorderBrush="#CBD5E1"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Скасувати" Padding="14,6" Margin="0,0,8,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="CancelBtn_Click"/>
            <Button Content="Зберегти" Padding="16,6" Background="#166534" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SaveBtn_Click"/>
        </StackPanel>
        </Grid>
</Window>
