<Window x:Class="Library.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        mc:Ignorable="d"
        Title="Про книгу" Height="450" Width="480">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Про книгу" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="BookIdText" Text="Інвентарний №: 1" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Назва видання:" Margin="0,4,0,2" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBox x:Name="TitleBox" Padding="8,6" FontSize="13" Background="White" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Автор:" Margin="0,10,0,2" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBox x:Name="AuthorBox" Padding="8,6" FontSize="13" Background="White" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Дисципліна / Спеціальність:" Margin="0,10,0,2" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBox x:Name="DisciplineBox" Padding="8,6" FontSize="13" Background="White" BorderBrush="#CBD5E1"/>

            <TextBlock Text="Кількість у наявності (примірників):" Margin="0,10,0,2" FontWeight="SemiBold" Foreground="#475569"/>
            <TextBox x:Name="CopiesBox" Padding="8,6" FontSize="13" Background="White" BorderBrush="#CBD5E1"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Видалити" Padding="50,7" 
                    Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" 
                    FontWeight="SemiBold" Cursor="Hand" Click="DeleteBtn_Click"/>
            <Button Content="Видати" Margin="156,0,31,0" Padding="50,7" 
                    Background="#E0E7FF" Foreground="#4338CA" BorderBrush="#C7D2FE" 
                    FontWeight="SemiBold" Cursor="Hand" Click="IssueBtn_Click" Grid.ColumnSpan="3"/>
            <Button Grid.Column="2" Content="Зберегти  " Margin="168,0,74,0" Padding="50,7" 
                    Background="#166534" Foreground="White" BorderThickness="0" 
                    Cursor="Hand" Click="EditBtn_Click" Grid.ColumnSpan="2"/>

        </Grid>
    </Grid>
</Window>
